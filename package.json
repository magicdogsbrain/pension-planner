{
  "name": "pension-planner",
  "version": "6.0.0",
  "description": "Pension Drawdown Planning Tool with Monte Carlo Stress Testing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.pension.planner",
    "productName": "Pension Planner",
    "mac": {
      "category": "public.app-category.finance",
      "target": "dmg",
      "icon": "icon.icns"
    },
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "icon.icns"
    ]
  }
}
